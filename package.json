{
  "name": "krida",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "setup": "node scripts/setup.mjs",
    "build": "tsc -b && vite build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "lint": "oxlint src convex server api shared workers tests --max-warnings 60",
    "typecheck": "tsc -b && tsc -p convex/tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "npm ci && npm run check:ci",
    "check:ci": "npm run build && npm run typecheck && npm run lint && npm test && node scripts/vercel-build.test.mjs && node scripts/delete-convex-preview.test.mjs && node scripts/check-merge-integration.mjs && node scripts/check-boundaries.ts && node scripts/check-colors.ts",
    "doctor": "node scripts/doctor.mjs",
    "regress": "node scripts/regress/run.ts",
    "qa": "node scripts/qa.ts",
    "release": "node scripts/release.ts"
  },
  "dependencies": {
    "@clerk/react": "^6.18.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/functions": "^3.9.11",
    "bubli": "file:vendor/bubli-0.3.3.tgz",
    "convex": "^1.46.0",
    "convex-helpers": "^0.1.128",
    "hls.js": "^1.7.3",
    "motion": "^14.0.0",
    "posthog-js": "^1.440.0",
    "posthog-node": "^5.57.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@posthog/cli": "^0.18.12",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "convex-test": "^0.0.60",
    "oxlint": "^1.81.0",
    "playwright-core": "^1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.27.0": true
  }
}
