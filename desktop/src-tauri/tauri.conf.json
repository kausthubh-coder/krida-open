{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Krida",
  "version": "0.1.10",
  "identifier": "app.krida",
  "build": {
    "frontendDist": "../offline"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["krida", "stremio"] }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzRUU2NDc1NEExMDBBRDIKUldUU0NoQktkV1R1OHoydHppVTIzaGlxOFkvZHA4c2JjSWo5cWorVGwyY1lZOVp4NGNEdU90SCsK",
      "endpoints": ["https://github.com/kausthubh-coder/krida-open-releases/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "resources": {
      "mpv/mpv.exe": "mpv/mpv.exe"
    },
    "publisher": "Krida",
    "shortDescription": "Krida for Windows",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma"
      }
    }
  }
}
