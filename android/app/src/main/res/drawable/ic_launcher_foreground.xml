<?xml version="1.0" encoding="utf-8"?>
<!-- favicon.svg's two triangles, centred in the 108dp adaptive canvas. The back one is white at 32% over the tile,
     drawn solid so its stroke and fill don't double up where they overlap. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group android:scaleX="1.2" android:scaleY="1.2" android:translateX="16.8" android:translateY="15.6">
        <path
            android:pathData="M15,20 L35,32 L15,44 Z"
            android:fillColor="#666361"
            android:strokeColor="#666361"
            android:strokeWidth="5"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M27,20 L47,32 L27,44 Z"
            android:fillColor="#FFFFFF"
            android:strokeColor="#FFFFFF"
            android:strokeWidth="5"
            android:strokeLineJoin="round" />
    </group>
</vector>
